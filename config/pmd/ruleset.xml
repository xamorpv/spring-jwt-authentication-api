<?xml version="1.0"?>
<ruleset name="Project Rules">
    <description>Полный набор правил PMD</description>

    <rule ref="category/java/bestpractices.xml">
        <!-- Избыточно -->
        <exclude name="GuardLogStatement"/>
    </rule>

    <rule ref="category/java/performance.xml"/>

    <rule ref="category/java/documentation.xml">
        <!-- Покрыто через Checkstyle -->
        <exclude name="CommentRequired"/>
        <exclude name="CommentSize"/>
    </rule>

    <rule ref="category/java/errorprone.xml">
        <!-- Избыточно -->
        <exclude name="ConstructorCallsOverridableMethod"/>
        <!-- Не используется в проекте -->
        <exclude name="MissingSerialVersionUID"/>
    </rule>

    <rule ref="category/java/codestyle.xml">
        <!-- покрыто через spotless -->
        <exclude name="UnnecessaryConstructor"/>
        <exclude name="UselessParentheses"/>
        <!-- Избыточно -->
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="CallSuperInConstructor"/>
        <!-- Исключаем правила, которые будем настраивать отдельно -->
        <exclude name="LongVariable"/>
    </rule>

    <rule ref="category/java/design.xml">
        <!-- Покрыто через ArchUnit -->
        <exclude name="LoosePackageCoupling"/>
        <!-- Избыточно -->
        <exclude name="LawOfDemeter"/>
        <!-- Исключаем правила, которые будем настраивать отдельно -->
        <exclude name="CyclomaticComplexity"/>
        <exclude name="TooManyMethods"/>
        <exclude name="TooManyFields"/>
        <exclude name="NcssCount"/>
    </rule>

    <!-- Отдельные правила с кастомными настройками -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="20"/>
            <property name="classReportLevel" value="150"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="80"/>
            <property name="methodReportLevel" value="10"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="25"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="15"/>
        </properties>
    </rule>

    <rule ref="category/java/codestyle.xml/LongVariable">
        <properties>
            <property name="minimum" value="30" />
        </properties>
    </rule>

    <exclude-pattern>.*/generated/.*</exclude-pattern>
</ruleset>